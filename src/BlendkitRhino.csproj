<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Rhino 8 runs on .NET 7 on both Windows and macOS. We multi-target
      so the same source produces a Windows-flavoured .rhp (net7.0-windows
      for System.Drawing.Icon + Win32 hooks) and a macOS-flavoured one
      (plain net7.0, no Windows-only types). Build both with
      `dotnet build -c Release` Ă˘â‚¬â€ť the artefacts land in
      bin/Release/net7.0-windows/ and bin/Release/net7.0/.
    -->
    <TargetFrameworks>net7.0-windows;net7.0</TargetFrameworks>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <RootNamespace>Blendkit.Rhino</RootNamespace>
    <!--
      Internal assembly / .rhp filename. Stays BlendkitRhino: the .rhp
      filename and assembly identity are internal and were already on
      the Blendkit spelling, so there's no reason to churn them (and the
      plug-in Guid below is what Rhino keys installs on anyway). The
      user-visible plug-in name is set to "Blendkit" via the explicit
      <Title>/<AssemblyTitle>/<Product> overrides below.
    -->
    <AssemblyName>BlendkitRhino</AssemblyName>
    <!-- Rhino loads plugins from .rhp files; rename the .dll output here. -->
    <TargetExt>.rhp</TargetExt>
    <NoWarn>NU1701;CS8032;CA1416</NoWarn>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <!--
      Plugin metadata visible in Rhino > Options > Plug-ins. These
      override MSBuild's defaults (which would otherwise derive
      AssemblyTitle/Product from AssemblyName, leaking the internal
      "BlendkitRhino" name into the UI).
    -->
    <Title>Blendkit</Title>
    <AssemblyTitle>Blendkit</AssemblyTitle>
    <Product>Blendkit</Product>
    <Description>Blendkit (formerly BlenderKit) asset browser - Rhino 8 port.</Description>
    <Version>0.1.3</Version>
    <Authors>Blendkit</Authors>
    <Company>Blendkit</Company>
    <!--
      Define WINDOWS_BUILD only on the Windows target so we can guard
      Win32 P/Invokes (mouse-wheel hook, GetCursorPos) at compile time.
      On the net7.0 (macOS-compatible) target, those code paths are
      stubbed to no-ops.
    -->
    <DefineConstants Condition="'$(TargetFramework)' == 'net7.0-windows'">$(DefineConstants);WINDOWS_BUILD</DefineConstants>
  </PropertyGroup>

  <!--
    System.Drawing.Common is needed because Panels.RegisterPanel takes a
    System.Drawing.Icon argument. Ship-wise we pass null, but the reference
    still has to resolve at compile time.
  -->
  <!-- Blendkit logo embedded as a manifest resource so the .rhp can load
       it via Assembly.GetManifestResourceStream and pass an Icon to
       Panels.RegisterPanel. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\blenderkit_logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="7.0.0" />
  </ItemGroup>

  <!--
    RhinoCommon comes from NuGet pinned at 8.0 (Rhino 8 GA, October 2023).
    Pinning at 8.0 Ă˘â‚¬â€ť instead of pointing at $(ProgramFiles)\Rhino 8\Ă˘â‚¬Â¦ as
    we used to Ă˘â‚¬â€ť lowers the Yak distribution tag from rh8_<build-machine-SR>
    down to rh8_0, so the package shows up in the Package Manager for
    every Rhino 8 user (not just those on the SR we happened to build
    against). The NuGet ships RhinoCommon.dll, Rhino.UI.dll, and Eto.dll
    together, so this single reference replaces every previous HintPath ref
    on both Windows and macOS Ă˘â‚¬â€ť no more probing for Rhino install paths,
    no more dependence on the build machine's Rhino SR.

    ExcludeAssets=runtime keeps these DLLs OUT of the build output Ă˘â‚¬â€ť
    Rhino's own install ships the canonical copies, and shadowing them
    with NuGet copies would break loading at runtime. PrivateAssets=all
    prevents the dependency from leaking into anything that consumes
    this assembly.
  -->
  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="8.0.23304.9001"
                      ExcludeAssets="runtime"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>
